      "destination": "https://wip.micr.dev/:match*",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "https://about.micr.dev/",
      "permanent": true
    },
    {
      "source": "/about/:match*",
      "destination": "https://about.micr.dev/:match*",
      "permanent": true
